  "vendor/bb/x0x/bass303.c": {
    "commit": "c54b18d9b2389d4053375171a7497fc70418e61e",
    "path": "vendor/bb/x0x/bass303.c",
    "sha256": "983c0512d4d9576e1543b151947dd1a72fb249b7d1257b508b17cdd6fe6e7412",
    "base_sha256": "f477006c97b4a367f7a9e6ad1f44654f0cedfa1c10515fbacc4289c078b90164",
    "local_change": "Elite held-key pitch bend and cutoff expression. Skip settled idle recursions with PCM and state parity against Build 658. Allow the Elite oscillator and filter loop to run in executable RAM. Use a constant chunk length in the one-sample control build."
